{
  "name": "gourses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase-connection.mjs",
    "migrate": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "ingest:coursera": "node --env-file=.env.local scripts/ingest-coursera.mjs",
    "test:integration": "node --env-file=.env.local node_modules/.bin/vitest run tests/integration"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

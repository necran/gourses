{
  "name": "gourses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:analitica": "playwright test --config playwright.analitica.config.ts",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase-connection.mjs",
    "migrate": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "ingest:coursera": "node --env-file=.env.local scripts/ingest-coursera.mjs",
    "ingest:udemy": "node --env-file=.env.local scripts/ingest-udemy.mjs",
    "resumir:cursos": "node --env-file=.env.local scripts/resumir-cursos.mjs",
    "clasificar:temas": "node --env-file=.env.local scripts/clasificar-temas.mjs",
    "boletin:semanal": "node --env-file=.env.local scripts/boletin-semanal.mjs",
    "test:integration": "node --env-file=.env.local node_modules/.bin/vitest run --no-file-parallelism tests/integration",
    "correo:plantillas": "node --env-file=.env.local scripts/aplicar-plantillas-correo.mjs",
    "correo:plantillas-nas": "node --env-file=.env.local scripts/plantillas-correo-nas.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

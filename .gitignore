# dependencias
node_modules/

# entorno local — nunca se commitea
.env
.env.local
.env.*.local
# Cualquier copia de seguridad de un fichero de entorno lleva las mismas claves
# dentro, así que se ignora igual. Sin esto, un `.env.local.bak` quedaría listo
# para commitear por accidente.
.env*.bak*
.env.local.*

# builds
.next/
dist/
build/
out/
*.tsbuildinfo
next-env.d.ts

# tests
coverage/
playwright-report/
test-results/
e2e/screenshots/

# config personal de Claude Code (no compartida con el equipo)
.claude/settings.local.json

# sistema
.DS_Store
*.log

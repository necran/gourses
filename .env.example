# Copiar a .env.local y rellenar. Nunca commitear .env.local (ver .gitignore).

# --- Supabase (self-hosted en el NAS mientras estamos en local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dirección base de ESTA instancia. Solo la usan los enlaces que tienen que
# volver aquí (el enlace de acceso por correo). En local: http://localhost:3000.
# Si se deja vacía se usa la canónica del sitio (https://gourses.com), que en
# local mandaría el enlace de acceso a producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Conexión directa a Postgres, solo para scripts de migración/ingesta ---
# Nunca se usa desde rutas de la web ni se expone al cliente (ver .claude/rules/seguridad.md).
DATABASE_URL=
# Base de datos separada, solo para tests de integración (nunca la de desarrollo).
TEST_DATABASE_URL=

# --- Fuentes de catálogo (Fase 1) ---
# Udemy Affiliate API usa Basic Auth con este par (base64 "client_id:client_secret").
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
UDEMY_AFFILIATE_API_BASE_URL=https://www.udemy.com
COURSERA_CATALOG_API_BASE_URL=https://api.coursera.org

# --- Afiliación vía Impact.com (comisión, no catálogo) ---
# Una sola cuenta de Impact cubre Udemy y Coursera: cambia el ProgramId, no las
# credenciales. Basic Auth = AccountSID (usuario) + token (contraseña).
IMPACT_ACCOUNT_SID=
IMPACT_API_TOKEN=
# Descubribles por API con las credenciales de arriba; se fijan aquí para no
# depender de una llamada extra en cada ingesta.
IMPACT_MEDIA_PARTNER_PROPERTY_ID=
IMPACT_UDEMY_PROGRAM_ID=
IMPACT_COURSERA_PROGRAM_ID=

# --- Alertas de precio (Fase 4) ---
# Sin RESEND_API_KEY el job de avisos corre igual: detecta las bajadas y las
# registra en el log en vez de enviarlas. Ponerla es lo único que hace falta
# para encender el envío de verdad (ver src/lib/alertas/enviar.ts).
RESEND_API_KEY=
# Remitente. Debe ser un dominio verificado en Resend o los correos se rechazan.
# Si se deja vacío se usa "Gourses <avisos@gourses.com>".
RESEND_FROM=

# --- Plantillas de correo de Supabase Auth (npm run correo:plantillas) ---
# Token personal de la Management API (Supabase → Account → Access Tokens).
# Solo lo necesita quien suba las plantillas a mano; ni la web ni la ingesta lo usan.
SUPABASE_ACCESS_TOKEN=
# Referencia del proyecto en Supabase Cloud (la de la URL del panel).
SUPABASE_PROJECT_REF=

# --- Supabase del NAS (solo desarrollo, npm run correo:plantillas-nas) ---
# El Supabase self-hosted no tiene Management API: las plantillas de correo se
# copian por ssh y las sirve un contenedor. Solo lo necesita quien las cambie.
NAS_SSH_DESTINO=usuario@host
NAS_SUPABASE_DIR=/volume1/docker/gourses-supabase
# Opcional, si la clave no es la que ssh elige por defecto.
NAS_SSH_KEY=

# El e2e que comprueba que la confirmación no revela si el correo tenía cuenta
# necesita que el envío funcione de verdad; sin esto se salta solo. Ponlo a 1
# cuando el Supabase que uses tenga correo saliente (en el NAS es Mailpit).
EMAIL_ENVIABLE=1
# Buzón de Mailpit del entorno de desarrollo. Solo lo usan los tests de
# integración del cambio de correo (HU-037), para leer los dos enlaces de
# confirmación sin depender de un buzón real; sin esto, esos tests se saltan.
MAILPIT_URL=

# --- Resumen de cursos con IA (Fase 5, npm run resumir:cursos) ---
# Clave de la API de Gemini — gratis, sin tarjeta: aistudio.google.com/apikey.
# Solo la necesita quien lance el job a mano; ni la web ni la ingesta la usan.
# Genera un resumen corto apoyado en la descripción real del curso, con
# Gemini 3.5 Flash Lite — nunca contenido inventado desde cero. El nivel gratuito
# limita las peticiones por minuto y por día; el job ya lo respeta y, si se
# agota la cuota de un día, lo que falte se recoge relanzándolo otro día (ver
# historias/HU-030-resumen-ia.md).
GEMINI_API_KEY=

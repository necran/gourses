# Copiar a .env.local y rellenar. Nunca commitear .env.local (ver .gitignore).

# --- Supabase (self-hosted en el NAS mientras estamos en local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión directa a Postgres, solo para scripts de migración/ingesta ---
# Nunca se usa desde rutas de la web ni se expone al cliente (ver .claude/rules/seguridad.md).
DATABASE_URL=
# Base de datos separada, solo para tests de integración (nunca la de desarrollo).
TEST_DATABASE_URL=

# --- Fuentes de catálogo (Fase 1) ---
# Udemy Affiliate API usa Basic Auth con este par (base64 "client_id:client_secret").
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
UDEMY_AFFILIATE_API_BASE_URL=https://www.udemy.com
COURSERA_CATALOG_API_BASE_URL=https://api.coursera.org

# --- Afiliación vía Impact.com (comisión, no catálogo) ---
# Una sola cuenta de Impact cubre Udemy y Coursera: cambia el ProgramId, no las
# credenciales. Basic Auth = AccountSID (usuario) + token (contraseña).
IMPACT_ACCOUNT_SID=
IMPACT_API_TOKEN=
# Descubribles por API con las credenciales de arriba; se fijan aquí para no
# depender de una llamada extra en cada ingesta.
IMPACT_MEDIA_PARTNER_PROPERTY_ID=
IMPACT_UDEMY_PROGRAM_ID=
IMPACT_COURSERA_PROGRAM_ID=

# --- Alertas de precio (Fase 4) ---
# Sin RESEND_API_KEY el job de avisos corre igual: detecta las bajadas y las
# registra en el log en vez de enviarlas. Ponerla es lo único que hace falta
# para encender el envío de verdad (ver src/lib/alertas/enviar.ts).
RESEND_API_KEY=
# Remitente. Debe ser un dominio verificado en Resend o los correos se rechazan.
# Si se deja vacío se usa "Gourses <avisos@gourses.com>".
RESEND_FROM=
